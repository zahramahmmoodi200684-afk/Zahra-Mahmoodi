    <title>Hypertension - High Blood Pressure Info</title>
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; line-height: 1.6; margin: 0; padding: 20px; background: #f4f4f4; }
        .container { max-width: 900px; margin: auto; background: white; padding: 30px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        h1 { color: #c0392b; border-bottom: 3px solid #e74c3c; padding-bottom: 10px; }
        h2 { color: #e67e22; margin-top: 25px; }
